    "version": "0.2.0",
    "configurations": [
        {
            "name": "Remote Attach",
            "type": "go",
            "request": "attach",
            "mode": "remote",
            "remotePath": "/root/golang/src/github.com/onexstack/miniblog", // 服务器上的项目路径
            "port": 2345,
            "host": "192.168.220.151"
        },
        {
            "name": "Launch mb-apiserver",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/cmd/mb-apiserver/main.go",
            "args": ["-c", "configs/mb-apiserver.yaml"],
            "cwd": "${workspaceFolder}",// Current Working Directory​​（当前工作目录）
            "env": {
                "GIN_MODE": "debug",  // 可选：设置环境变量
                // "FASTGO_JWT_KEY": "xxx-jwt-key",
                // "FASTGO_MYSQL_ADDR": "XXX-mysql-addr:8888"
            }
        },
        {
            "name": "Debug Source-1",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/hello/viper-demo-2/main.go",
            "args": ["-c", "./config.yaml"]
        }
    ]
}